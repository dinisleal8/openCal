{
    "name": "openCal",
    "short_name": "openCal",
    "description": "Self-hosted calorie and health tracker",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#ffffff",
    "theme_color": "#0a0a0a",
    "icons": [
        {
            "src": "/icons/app-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "/icons/app-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "/icons/app-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/apple-touch-icon.png",
            "sizes": "180x180",
            "type": "image/png"
        }
    ]
}
